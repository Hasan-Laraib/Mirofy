{
  "name": "@product/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:golden": "node scripts/golden.mjs",
    "test:conformance": "node scripts/conformance.mjs",
    "build": "node scripts/build-artifacts.mjs",
    "check:artifacts": "node scripts/build-artifacts.mjs --check",
    "check:size": "node scripts/check-size-budget.mjs",
    "check:audit": "npm audit --audit-level=high",
    "check:harvest": "node scripts/check-harvest-identity.mjs",
    "build:template": "node packages/viewer/build.mjs",
    "check:template": "node scripts/check-template.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:golden && npm run check:template && npm run check:harvest && npm run test:conformance && npm run check:artifacts && npm run check:size && npm run check:audit"
  },
  "devDependencies": {
    "@types/node": "^18",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2"
  }
}
