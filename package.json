{
  "name": "@mirofy/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:golden": "node scripts/golden.mjs",
    "test:conformance": "node scripts/conformance.mjs",
    "build": "node scripts/build-artifacts.mjs",
    "check:artifacts": "node scripts/build-artifacts.mjs --check",
    "check:size": "node scripts/check-size-budget.mjs",
    "check:audit": "npm audit --audit-level=high",
    "check:readme": "node scripts/check-readme-claims.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:drift": "node scripts/check-core-drift.mjs",
    "build:template": "node packages/viewer/build.mjs",
    "check:template": "node scripts/check-template.mjs",
    "gallery": "node scripts/gallery.mjs",
    "build:site": "node scripts/build-site.mjs",
    "scan": "node packages/scanner/bin/scan.mjs",
    "model": "node packages/model/bin/model.mjs",
    "compile": "node packages/compile/bin/compile.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:golden && npm run check:template && npm run check:drift && npm run test:conformance && npm run check:artifacts && npm run check:size && npm run check:audit && npm run check:readme && npm run check:changelog",
    "test:quarantine": "node scripts/run-tests.mjs --quarantine",
    "explain": "node packages/explain/bin/explain.mjs",
    "assert": "node packages/explain/bin/assert.mjs",
    "mcp": "node packages/mcp/bin/mcp.mjs",
    "timeline": "node packages/explain/bin/timeline.mjs",
    "drift": "node packages/explain/bin/drift.mjs",
    "export": "node packages/export/bin/export.mjs",
    "layout": "node packages/layout/bin/layout.mjs"
  },
  "devDependencies": {
    "@types/node": "^18",
    "axe-core": "4.10.2",
    "eslint": "^9.15.0",
    "marked": "14.1.3",
    "typescript": "^5.7.2"
  }
}
