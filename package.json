{
  "name": "@product/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:golden": "node scripts/golden.mjs",
    "test:conformance": "node scripts/conformance.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:golden && npm run test:conformance"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "typescript": "^5.7.2"
  }
}
