{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Hasan-Laraib/mirofy",
  "title": "Mirofy",
  "description": "Ask a repository what depends on what. Every answer cites the file, line and commit it came from.",
  "version": "0.6.0",
  "repository": {
    "url": "https://github.com/Hasan-Laraib/Mirofy",
    "source": "github"
  },
  "websiteUrl": "https://hasan-laraib.github.io/Mirofy/",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mirofy-cli",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
