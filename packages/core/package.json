{
  "name": "mirofy-cli",
  "version": "0.5.4",
  "type": "module",
  "description": "Repository diagrams that cite their sources. Every edge names the file, line and commit it came from, and every file it could not read is listed by name. Reads JavaScript, TypeScript, Python, Go, Java, Rust and Kotlin. Zero dependencies, one self-contained HTML file.",
  "license": "MIT",
  "bin": {
    "mirofy": "bin/mirofy.mjs",
    "mirofy-cli": "bin/mirofy.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs",
    "check:brand-marks": "node scripts/generate-brand-marks.mjs --check",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "prepublishOnly": "node ../../scripts/build-pipeline.mjs && node ../../scripts/prepublish-guard.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "parse5": "7.3.0",
    "saxes": "6.0.0",
    "simple-icons": "16.29.0"
  },
  "keywords": [
    "architecture-diagram",
    "dependency-graph",
    "code-visualization",
    "repository-map",
    "codebase-visualization",
    "import-graph",
    "static-analysis",
    "provenance",
    "golang",
    "rust",
    "kotlin",
    "java",
    "typescript",
    "python",
    "cli",
    "documentation",
    "documentation-tool",
    "zero-dependency",
    "diagram",
    "system-design",
    "mermaid",
    "agent-skill",
    "mcp"
  ],
  "homepage": "https://hasan-laraib.github.io/Mirofy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hasan-Laraib/Mirofy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Hasan-Laraib/Mirofy/issues"
  },
  "author": "Hasan-Laraib",
  "exports": {
    ".": "./bin/mirofy.mjs",
    "./schemas/*": "./schemas/*",
    "./examples/*": "./examples/*",
    "./renderers/shared/*": "./renderers/shared/*",
    "./package.json": "./package.json"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "bin",
    "pipeline",
    "renderers",
    "schemas",
    "assets",
    "brand-marks",
    "references",
    "recipes",
    "delta",
    "examples",
    "scripts/check-render-output.mjs",
    "scripts/render-examples.mjs"
  ]
}
