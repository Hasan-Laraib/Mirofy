node_modules/
dist/
build/
.artifacts/
*.log
.DS_Store
.env

# Rendered examples are build output; regenerate with `npm run build`.
packages/core/examples/*.html

# Gallery output -- regenerate with `npm run gallery`. ~17 MB of rendered
# artifacts; committing this is the exact debt P1a removed.
preview/
site/

# SDD working artifacts: briefs, reports, review packages, ledger.
.superpowers/

# Scanner output from `npm run scan`.
scan/

# View compiler output from `npm run compile`.
scan/view.json

# Benchmark credentials. Never committed.
.benchmark.env
launch/

# Generated by scripts/build-pipeline.mjs. The source of truth is
# packages/<name>/; this is the copy that ships inside mirofy-cli.
packages/core/pipeline/

# Test scratch. Inside packages/core because ajv resolves through its
# node_modules; dot-prefixed so everything reading that package skips it.
packages/core/.scratch/

# build-pipeline stages here and swaps atomically; dot-prefixed so everything
# that reads packages/core skips it.
packages/core/.pipeline-next/
packages/core/.pipeline-previous/
